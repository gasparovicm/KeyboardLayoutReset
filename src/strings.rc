// UI text for the tray menu and messages. main.c (pick_ui_language) uses the
// block matching the Windows display language, else English (US).
// Keep the %s / %lu placeholders when translating. Saved as UTF-16 because
// rc.exe misreads some UTF-8 text even with #pragma code_page(65001).
#include <winres.h>
#include "resource.h"

// en
LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
STRINGTABLE
BEGIN
  IDS_SWITCH_NOW       "Switch to %s now"
  IDS_DEFAULT_KEYBOARD "Default keyboard"
  IDS_IDLE_TIME        "Idle time"
  IDS_PAUSE            "Pause"
  IDS_EXIT             "Exit"
  IDS_ACTIVE           "active"
  IDS_PAUSED           "paused"
  IDS_SECONDS          "%lu s"
  IDS_MINUTES          "%lu min"
  IDS_CUSTOM           "%s (custom)"
  IDS_NO_LAYOUT        "No keyboard layout to switch to was found."
END

