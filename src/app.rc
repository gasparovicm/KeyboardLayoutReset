// Resource id 1 is both the exe icon and the tray icon.
// Regenerate app.ico with tools\make-icon.ps1.
1 ICON "app.ico"

1 VERSIONINFO
FILEVERSION 0,3,0,0
PRODUCTVERSION 0,3,0,0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "KeyboardLayoutReset - switch keyboard back to a default layout when idle"
      VALUE "ProductName", "KeyboardLayoutReset"
      VALUE "FileVersion", "0.3.0"
      VALUE "ProductVersion", "0.3.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
